{
	"name": "obsidian-maps",
	"version": "0.1.6",
	"description": "Adds map view to Obsidian Bases.",
	"main": "main.js",
	"scripts": {
		"dev": "node scripts/generate-rtl-plugin.mjs && node esbuild.config.mjs",
		"build": "node scripts/generate-rtl-plugin.mjs && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint src package.json",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"maps",
		"bases"
	],
	"author": "Obsidian",
	"authorUrl": "https://obsidian.md",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@eslint/json": "^0.14.0",
		"@types/node": "24.6.1",
		"@typescript-eslint/parser": "^8.65.0",
		"esbuild": "^0.25.10",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"obsidian": "latest",
		"tslib": "2.8.1",
		"typescript": "5.9.3",
		"typescript-eslint": "^8.65.0"
	},
	"dependencies": {
		"@mapbox/mapbox-gl-rtl-text": "^0.3.0",
		"maplibre-gl": "5.24.0"
	}
}
